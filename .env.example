# Local dev with an AI Studio key (free tier; do NOT use with real colleagues' work):
GEMINI_API_KEY=
# Or Vertex AI (what Cloud Run uses, via the service account):
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# EMBED_MODEL defaults to text-embedding-005 on Vertex, gemini-embedding-001 on AI Studio
# Force offline mode (no model calls, lists matching items):
OFFLINE=
# Set to 0 to keep the evidence store in memory only:
EVIDENCE_PERSIST=
